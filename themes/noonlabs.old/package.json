{
  "name": "slidev-theme-noonlabs",
  "version": "1.0.0",
  "description": "NoonLabs Slidev theme. Ink and paper surfaces, bronze accent.",
  "keywords": ["slidev-theme", "slidev", "noonlabs"],
  "license": "MIT",
  "engines": {
    "slidev": ">=52.0.0"
  },
  "slidev": {
    "defaults": {
      "transition": "fade",
      "aspectRatio": "16/9"
    },
    "colorSchema": "dark",
    "highlighter": "shiki",
    "fonts": {
      "sans": "IBM Plex Sans",
      "serif": "IBM Plex Serif",
      "mono": "JetBrains Mono",
      "weights": "300,400,500,600,700"
    }
  }
}
